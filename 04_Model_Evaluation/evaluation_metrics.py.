import json
import os

import matplotlib.pyplot as plt
import numpy as np
import seaborn as sns
from sklearn.metrics import (
    accuracy_score,
    classification_report,
    confusion_matrix,
    precision_score,
    recall_score,
    f1_score,
)


def evaluate_model(y_true, y_pred, class_names, output_dir="evaluation_results"):
    """
    Evaluate a CNN classifier using actual and predicted class labels.

    Parameters:
        y_true: Actual class labels.
        y_pred: Predicted class labels.
        class_names: Names of the classes in label order.
        output_dir: Directory where evaluation results are saved.
    """

    os.makedirs(output_dir, exist_ok=True)

    labels = list(range(len(class_names)))

    accuracy = accuracy_score(y_true, y_pred)
    precision = precision_score(
        y_true, y_pred, labels=labels, average="macro", zero_division=0
    )
    recall = recall_score(
        y_true, y_pred, labels=labels, average="macro", zero_division=0
    )
    f1 = f1_score(
        y_true, y_pred, labels=labels, average="macro", zero_division=0
    )

    report = classification_report(
        y_true,
        y_pred,
        labels=labels,
        target_names=class_names,
        output_dict=True,
        zero_division=0,
    )

    matrix = confusion_matrix(y_true, y_pred, labels=labels)

    results = {
        "accuracy": float(accuracy),
        "macro_precision": float(precision),
        "macro_recall": float(recall),
        "macro_f1_score": float(f1),
        "classification_report": report,
        "confusion_matrix": matrix.tolist(),
        "class_names": class_names,
    }

    results_path = os.path.join(output_dir, "evaluation_results.json")

    with open(results_path, "w", encoding="utf-8") as file:
        json.dump(results, file, indent=4)

    # Save the confusion matrix plot.
    plt.figure(figsize=(8, 6))

    sns.heatmap(
        matrix,
        annot=True,
        fmt="d",
        cmap="Blues",
        xticklabels=class_names,
        yticklabels=class_names,
    )

    plt.title("Confusion Matrix")
    plt.xlabel("Predicted Label")
    plt.ylabel("Actual Label")
    plt.tight_layout()

    matrix_path = os.path.join(output_dir, "confusion_matrix.png")
    plt.savefig(matrix_path, dpi=300)
    plt.close()

    print("\nMODEL EVALUATION RESULTS")
    print("------------------------")
    print(f"Accuracy:  {accuracy:.4f}")
    print(f"Precision: {precision:.4f}")
    print(f"Recall:    {recall:.4f}")
    print(f"F1-Score:  {f1:.4f}")

    print("\nClassification Report:")
    print(
        classification_report(
            y_true,
            y_pred,
            labels=labels,
            target_names=class_names,
            zero_division=0,
        )
    )

    print(f"Results saved to: {results_path}")
    print(f"Confusion matrix saved to: {matrix_path}")

    return results


if __name__ == "__main__":
    # Example demonstrating how to use the evaluation function.
    # Replace these example labels with predictions from your trained model.

    class_names = ["Glioma", "Meningioma", "No Tumor", "Pituitary"]

    y_true = np.array([0, 1, 2, 3, 0, 1, 2, 3])
    y_pred = np.array([0, 1, 2, 3, 0, 1, 3, 3])

    evaluate_model(y_true, y_pred, class_names)
